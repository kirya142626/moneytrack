# MoneyTrack — переменные окружения
# Скопируйте этот файл в .env.local для локальной разработки:
#   cp .env.example .env.local
#
# Локально без переменных Supabase приложение работает на SQLite.
# На Vercel локальный режим запрещён: без переменных Supabase сайт вернёт 503.
# Пошаговая публикация — DEPLOY.md.

# ---------------------------------------------------------------------------
# Supabase (обязательно для production)
# ---------------------------------------------------------------------------
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# anon public / publishable ключ. Безопасен для клиента: доступ ограничен RLS.
# НЕ используйте service_role / secret ключ — приложению он не нужен.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Приложение
# ---------------------------------------------------------------------------
# Публичный адрес сайта без завершающего слэша.
# Используется в ссылках подтверждения почты и сброса пароля.
# Локально:    http://localhost:3000
# Production:  https://moneytrack.example (свой домен или *.vercel.app)
# После изменения переменной сделайте Redeploy: NEXT_PUBLIC_* встраиваются в сборку.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Локальный режим (SQLite) — только вне Vercel
# ---------------------------------------------------------------------------
# Не задавайте эту переменную на Vercel: там используется только Supabase.
# Путь к файлу базы относительно корня проекта.
# По умолчанию: data/moneytrack.db
MONEYTRACK_DB_PATH=data/moneytrack.db
